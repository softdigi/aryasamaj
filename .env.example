APP_NAME="Arya Samaj"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://aryasamaj.site/app_api

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=aryasamaj_db
DB_USERNAME=root
DB_PASSWORD=your_password

# CORS: set to the exact origin of your Flutter/web client
CORS_ALLOWED_ORIGIN=https://aryasamaj.site

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
# Production: FILESYSTEM_DISK=r2
QUEUE_CONNECTION=database
# Production: QUEUE_CONNECTION=redis

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Cloudflare R2 object storage (S3-compatible).
# Set FILESYSTEM_DISK=r2 and fill these to enable.
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=aryasamaj-uploads
CLOUDFLARE_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
CDN_URL=https://cdn.aryasamaj.site

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Sanctum: token expiry in minutes (default 30 days = 43200).
# Set to null to disable expiry.
SANCTUM_TOKEN_EXPIRY=43200

VITE_APP_NAME="${APP_NAME}"
