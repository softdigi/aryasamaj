<?xml version="1.0" encoding="utf-8"?>
<!--
    Debug-only network security config:
    - Cleartext (HTTP) is allowed only for localhost / 10.0.2.2 (Android emulator host).
    - All other traffic must use HTTPS.
    - User-installed CA certificates are trusted (for Charles / mitmproxy debugging).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
            <certificates src="user"/>
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
    </domain-config>
</network-security-config>
